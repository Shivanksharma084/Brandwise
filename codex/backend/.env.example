# =============================================================================
# Brandwise Platform — Environment Variables (copy to .env and fill in)
# =============================================================================

# --- Application ---
APP_NAME=Brandwise
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-secret-key-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_SERVER=db
POSTGRES_USER=brandwise
POSTGRES_PASSWORD=brandwise_password
POSTGRES_DB=brandwise
DATABASE_URL=postgresql+asyncpg://brandwise:brandwise_password@db:5432/brandwise
SYNC_DATABASE_URL=postgresql+psycopg2://brandwise:brandwise_password@db:5432/brandwise

# --- Redis (Celery broker / cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0

# --- MinIO (S3-compatible file storage) ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=brandwise-assets
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://minio:9000

# --- Celery ---
CELERY_BROKER_URL=redis://:redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password@redis:6379/1

# --- LLM providers (optional, at least one recommended) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic   # anthropic | openai | local
LLM_MODEL=claude-3-haiku-20240307
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- External tools ---
TESSERACT_CMD=/usr/bin/tesseract

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BCRYPT_ROUNDS=12

# --- Tenant / RLS ---
DEFAULT_TENANT_SLUG=default
